    {
      "module": "module.lambda",
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "order_saga",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:states:us-east-1:294417223953:stateMachine:OrderSagaStateMachine",
            "creation_date": "2025-07-06T21:30:40Z",
            "definition": "{\n  \"Comment\": \"State machine for processing the order saga with Choice states\",\n  \"StartAt\": \"OrderService\",\n  \"States\": {\n    \"OrderService\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:294417223953:function:orderServiceFunction\",\n        \"Payload\": { \"input.$\": \"$\" }\n      },\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"FailSaga\"\n        }\n      ],\n      \"Next\": \"InventoryService\"\n    },\n\n    \"InventoryService\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:294417223953:function:inventoryServiceFunction\",\n        \"Payload\": { \"input.$\": \"$\" }\n      },\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"FailSaga\"\n        }\n      ],\n      \"Next\": \"CheckInventory\"\n    },\n\n    \"CheckInventory\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.Payload.statusCode\",\n          \"NumericEquals\": 404,\n          \"Next\": \"CancelOrder\"\n        }\n      ],\n      \"Default\": \"PaymentService\"\n    },\n\n    \"PaymentService\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:294417223953:function:paymentServiceFunction\",\n        \"Payload\": { \"input.$\": \"$\" }\n      },\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"FailSaga\"\n        }\n      ],\n      \"Next\": \"CheckPayment\"\n    },\n\n    \"CheckPayment\": {\n      \"Type\": \"Choice\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.Payload.statusCode\",\n          \"NumericEquals\": 402,\n          \"Next\": \"ReleaseInventory\"\n        }\n      ],\n      \"Default\": \"CompleteSaga\"\n    },\n\n    \"ReleaseInventory\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:294417223953:function:releaseInventoryFunction\",\n        \"Payload\": { \"input.$\": \"$\" }\n      },\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"FailSaga\"\n        }\n      ],\n      \"Next\": \"CancelOrder\"\n    },\n\n    \"CancelOrder\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-east-1:294417223953:function:cancelOrderFunction\",\n        \"Payload\": { \"input.$\": \"$\" }\n      },\n      \"Next\": \"FailSaga\"\n    },\n\n    \"CompleteSaga\": {\n      \"Type\": \"Succeed\"\n    },\n\n    \"FailSaga\": {\n      \"Type\": \"Fail\",\n      \"Cause\": \"SagaFailed\"\n    }\n  }\n}\n",
            "description": "",
            "encryption_configuration": [
              {
                "kms_data_key_reuse_period_seconds": 0,
                "kms_key_id": "",
                "type": "AWS_OWNED_KEY"
              }
            ],
            "id": "arn:aws:states:us-east-1:294417223953:stateMachine:OrderSagaStateMachine",
            "logging_configuration": [
              {
                "include_execution_data": false,
                "level": "OFF",
                "log_destination": ""
              }
            ],
            "name": "OrderSagaStateMachine",
            "name_prefix": "",
            "publish": false,
            "revision_id": "",
            "role_arn": "arn:aws:iam::294417223953:role/order-saga-sfn-role",
